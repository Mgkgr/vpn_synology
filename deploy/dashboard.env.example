# Docker binds localhost only; DSM Reverse Proxy terminates public TLS on 10443.
DASHBOARD_BIND=127.0.0.1:8088
MIHOMO_URL=http://vpn-wireguard:9091
WGEASY_URL=http://vpn-wireguard:51821
METACUBEXD_URL=http://metacubexd:80
KUMA_URL=http://uptime-kuma:3001
# Required production secret file. `prepare-runtime.sh` creates it from a
# legacy DASHBOARD_ENCRYPTION_KEY value once, then removes that value from env.
DASHBOARD_ENCRYPTION_KEY_FILE=/run/secrets/dashboard_encryption_key
# Optional: add `MIHOMO_API_SECRET_FILE=/run/secrets/mihomo_api_secret` only
# when the controller is configured with a secret.
DATABASE_PATH=/data/dashboard.sqlite3
DIRECT_RULES_PATH=/gateway/rules/direct.txt
GEODATA_DIR=/geodata
# Enable only after isolated DASH-SITE-* groups pass NAS acceptance.
SITE_PROBES_ENABLED=false
# Enable only after the installed worker and its runtime pass NAS acceptance.
# This exposes scoped controls, not an Auto policy or general Docker access.
MAINTENANCE_ENABLED=false
